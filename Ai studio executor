--// Console Logger
local function logConsole(kind, ...)
	local parts = {}
	for i = 1, select("#", ...) do
		table.insert(parts, tostring(select(i, ...)))
	end
	local msg = table.concat(parts, " ")
	local timestamp = os.date("%H:%M:%S")

	local color = THEME.TextPrimary
	local prefix = "[LOG]"
	if kind == "warn" then
		color = THEME.Yellow
		prefix = "[WARN]"
	elseif kind == "error" then
		color = THEME.Pink
		prefix = "[ERR]"
	elseif kind == "sys" then
		color = THEME.Cyan
		prefix = "[SYS]"
	elseif kind == "ok" then
		color = THEME.Green
		prefix = "[OK]"
	end

	local line = Instance.new("TextLabel")
	line.Size = UDim2.new(1, 0, 0, 0)
	line.AutomaticSize = Enum.AutomaticSize.Y
	line.BackgroundTransparency = 1
	line.Font = Enum.Font.Code
	line.TextSize = 11
	line.TextWrapped = true
	line.TextXAlignment = Enum.TextXAlignment.Left
	line.TextColor3 = color
	line.Text = string.format("[%s] %s %s", timestamp, prefix, msg)
	line.Parent = ConsoleScroll

	task.defer(function()
		ConsoleScroll.CanvasPosition = Vector2.new(0, ConsoleScroll.AbsoluteCanvasSize.Y)
	end)
end

--// Editor Sync (Syntax Highlighting + Line Numbers + Undo + Auto-Save)
local saveDebounceToken = 0

local function syncEditorVisuals()
	local text = CodeBox.Text
	HighlightDisplay.Text = highlightLuau(text)

	local _, lineCount = string.gsub(text, "\n", "\n")
	local nums = {}
	for i = 1, lineCount + 1 do
		nums[i] = tostring(i)
	end
	LineNumbers.Text = table.concat(nums, "\n")

	if not State.SuppressUndo and text ~= State.LastText then
		table.insert(State.UndoStack, State.LastText)
		if #State.UndoStack > 40 then
			table.remove(State.UndoStack, 1)
		end
		State.LastText = text
	end

	if State.AutoSaveEnabled then
		saveDebounceToken += 1
		local token = saveDebounceToken
		AutoSaveIndicator.Text = "Auto-Save: Pending..."
		AutoSaveIndicator.TextColor3 = THEME.Yellow
		task.delay(0.8, function()
			if token == saveDebounceToken and State.AutoSaveEnabled then
				local val = SaveFolder:FindFirstChild(State.CurrentScriptName)
				if not val then
					val = Instance.new("StringValue")
					val.Name = State.CurrentScriptName
					val.Parent = SaveFolder
				end
				val.Value = CodeBox.Text
				AutoSaveIndicator.Text = "Auto-Save: Saved"
				AutoSaveIndicator.TextColor3 = THEME.Green
			end
		end)
	end
end

CodeBox:GetPropertyChangedSignal("Text"):Connect(syncEditorVisuals)

local function setEditorText(name, content)
	State.CurrentScriptName = name
	EditorTabLabel.Text = name
	StatusBadge.Text = "• " .. name
	State.SuppressUndo = true
	State.LastText = content
	CodeBox.Text = content
	State.SuppressUndo = false
	syncEditorVisuals()
end

--// Explorer List Refresh
local function refreshExplorer()
	for _, child in ipairs(ExplorerScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local items = SaveFolder:GetChildren()
	table.sort(items, function(a, b)
		return a.Name < b.Name
	end)

	for _, sv in ipairs(items) do
		if sv:IsA("StringValue") then
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -4, 0, 28)
			row.BackgroundColor3 = (sv.Name == State.CurrentScriptName) and THEME.BgHover or THEME.BgSurface
			row.Parent = ExplorerScroll
			addCorner(row, 6)

			local btn = Instance.new("TextButton")
			btn.Size = UDim2.new(1, -28, 1, 0)
			btn.Position = UDim2.fromOffset(6, 0)
			btn.BackgroundTransparency = 1
			btn.Font = Enum.Font.Code
			btn.TextSize = 11
			btn.TextXAlignment = Enum.TextXAlignment.Left
			btn.TextTruncate = Enum.TextTruncate.AtEnd
			btn.Text = sv.Name
			btn.TextColor3 = (sv.Name == State.CurrentScriptName) and THEME.Cyan or THEME.TextPrimary
			btn.Parent = row

			btn.MouseButton1Click:Connect(function()
				setEditorText(sv.Name, sv.Value)
				refreshExplorer()
				logConsole("sys", "Loaded script:", sv.Name)
			end)

			local del = Instance.new("TextButton")
			del.AnchorPoint = Vector2.new(1, 0.5)
			del.Position = UDim2.new(1, -4, 0.5, 0)
			del.Size = UDim2.fromOffset(20, 20)
			del.BackgroundTransparency = 1
			del.Font = Enum.Font.GothamBold
			del.TextSize = 11
			del.Text = "×"
			del.TextColor3 = THEME.Pink
			del.Parent = row

			del.MouseButton1Click:Connect(function()
				if #SaveFolder:GetChildren() <= 1 then
					logConsole("warn", "Cannot delete the last remaining script.")
					return
				end
				local deletedName = sv.Name
				sv:Destroy()
				local first = SaveFolder:FindFirstChildOfClass("StringValue")
				if first and State.CurrentScriptName == deletedName then
					setEditorText(first.Name, first.Value)
				end
				refreshExplorer()
				logConsole("sys", "Removed script:", deletedName)
			end)
		end
	end
end

