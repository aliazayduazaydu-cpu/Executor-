		lbl.TextSize = 11
		lbl.TextColor3 = THEME.TextMuted
		lbl.Text = "No matching scripts found."
		lbl.Parent = empty
	end
end

local function fetchHubWithAnimation(query)
	HubLoadingBarBg.Visible = true
	HubLoadingBarFill.Position = UDim2.fromScale(-0.4, 0)
	local anim = TweenService:Create(
		HubLoadingBarFill,
		TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{ Position = UDim2.fromScale(1, 0) }
	)
	anim:Play()
	task.delay(0.45, function()
		HubLoadingBarBg.Visible = false
		renderHubItems(query)
	end)
end

HubSearchInput:GetPropertyChangedSignal("Text"):Connect(function()
	renderHubItems(HubSearchInput.Text)
end)

HubRefreshBtn.MouseButton1Click:Connect(function()
	logConsole("sys", "Refreshing Hub catalog from", HUB_API_ENDPOINT)
	fetchHubWithAnimation(HubSearchInput.Text)
end)
