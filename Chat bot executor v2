-- Saved scripts
local savedLayout = create("UIListLayout", {
    Padding = UDim.new(0,8),
    SortOrder = Enum.SortOrder.LayoutOrder
}, savedPage)

local function refreshSaved()
    for _,v in ipairs(savedPage:GetChildren()) do
        if v:IsA("Frame") then
            v:Destroy()
        end
    end

    for index,data in ipairs(savedScripts) do
        local item = create("Frame", {
            Size = UDim2.new(1,0,0,55),
            BackgroundColor3 = C.Panel,
            BorderSizePixel = 0,
            LayoutOrder = index
        }, savedPage)

        corner(item,8)

        create("TextLabel", {
            Size = UDim2.new(0.48,0,1,0),
            Position = UDim2.fromOffset(10,0),
            BackgroundTransparency = 1,
            Text = data.name,
            TextColor3 = C.White,
            TextSize = 12,
            Font = Enum.Font.GothamSemibold,
            TextXAlignment = Enum.TextXAlignment.Left
        },item)

        local load = button(item,"Load",C.Button)
        load.Size = UDim2.fromOffset(55,32)
        load.Position = UDim2.new(1,-120,0.5,-16)

        load.MouseButton1Click:Connect(function()
            editor.Text = data.code
            executePage.Visible = true
            savedPage.Visible = false
            learnPage.Visible = false
            setStatus("Script loaded")
        end)

        local delete = button(item,"X",C.Red)
        delete.Size = UDim2.fromOffset(32,32)
        delete.Position = UDim2.new(1,-40,0.5,-16)

        delete.MouseButton1Click:Connect(function()
            table.remove(savedScripts,index)
            refreshSaved()
        end)
    end
end

saveButton.MouseButton1Click:Connect(function()
    if editor.Text == "" then
        setStatus("Nothing to save",C.Red)
        return
    end

    table.insert(savedScripts,{
        name = "Script "..(#savedScripts+1),
        code = editor.Text
    })

    refreshSaved()
    setStatus("Saved for this session",C.Green)
end)

