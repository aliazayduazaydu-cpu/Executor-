-- Run only known educational demonstrations
local function runDemo(code)
    local h = player.Character
        and player.Character:FindFirstChildOfClass("Humanoid")

    if code == examples[3][2] then
        if h then h.WalkSpeed = 24 end
    elseif code == examples[4][2] then
        if h then h.WalkSpeed = 16 end
    elseif code == examples[5][2] then
        if h then h.JumpPower = 60 end
    elseif code == examples[6][2] then
        if h then h.JumpPower = 50 end
    elseif code == examples[11][2] then
        workspace.CurrentCamera.FieldOfView = 85
    elseif code == examples[12][2] then
        workspace.CurrentCamera.FieldOfView = 70
    elseif code == examples[13][2] then
        game:GetService("Lighting").ClockTime = 14
    elseif code == examples[14][2] then
        game:GetService("Lighting").ClockTime = 0
    else
        return false
    end

    return true
end

