--// UI Styling Helpers
local function addCorner(parent, r)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = parent
	return c
end

local function addStroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.4
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function attachHoverTween(btn)
	local scale = Instance.new("UIScale")
	scale.Scale = 1
	scale.Parent = btn
	local ti = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

	btn.MouseEnter:Connect(function()
		TweenService:Create(scale, ti, { Scale = 1.05 }):Play()
	end)
	btn.MouseLeave:Connect(function()
		TweenService:Create(scale, ti, { Scale = 1 }):Play()
	end)
	btn.MouseButton1Down:Connect(function()
		TweenService:Create(scale, ti, { Scale = 0.94 }):Play()
	end)
	btn.MouseButton1Up:Connect(function()
		TweenService:Create(scale, ti, { Scale = 1.05 }):Play()
	end)
end

--// Console Logger (Auto-scrolls to bottom)
local function LogConsole(kind, ...)
	if not UI.ConsoleScroll or not UI.ConsoleScroll.Parent then
		return
	end
	local theme = THEMES[State.ThemeName]
	local parts = {}
	for i = 1, select("#", ...) do
		table.insert(parts, tostring(select(i, ...)))
	end
	local text = table.concat(parts, " ")
	local color = theme.TextPrimary
	local tag = "[OUT]"

	if kind == "warn" then
		color = theme.Yellow
		tag = "[WARN]"
	elseif kind == "error" then
		color = theme.Red
		tag = "[ERR]"
	elseif kind == "sys" then
		color = theme.Cyan
		tag = "[SYS]"
	elseif kind == "ok" then
		color = theme.Green
		tag = "[OK]"
	end

	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, -6, 0, 0)
	lbl.AutomaticSize = Enum.AutomaticSize.Y
	lbl.BackgroundTransparency = 1
	lbl.Font = Enum.Font.Code
	lbl.TextSize = math.max(11, State.FontSize - 2)
	lbl.TextWrapped = true
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextColor3 = color
	lbl.Text = string.format("[%s] %s %s", os.date("%H:%M:%S"), tag, text)
	lbl.Parent = UI.ConsoleScroll

	-- Auto-scroll smoothly after layout recalculation
	task.defer(function()
		if UI.ConsoleScroll and UI.ConsoleScroll.Parent then
			UI.ConsoleScroll.CanvasPosition = Vector2.new(0, UI.ConsoleScroll.AbsoluteCanvasSize.Y)
		end
	end)
end

--// Apply Dark/Light Theme via CollectionService Tags
local function ApplyTheme(themeName)
	State.ThemeName = themeName
	local t = THEMES[themeName]

	for _, obj in ipairs(CollectionService:GetTagged(TAG_PANEL)) do
		if obj:IsA("GuiObject") then
			obj.BackgroundColor3 = t.MainBg
		end
	end
	for _, obj in ipairs(CollectionService:GetTagged(TAG_SURFACE)) do
		if obj:IsA("GuiObject") then
			obj.BackgroundColor3 = t.Surface
		end
	end
	for _, obj in ipairs(CollectionService:GetTagged(TAG_TEXT)) do
		if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
			obj.TextColor3 = t.TextPrimary
		end
	end

	if UI.EditorFrame then UI.EditorFrame.BackgroundColor3 = t.EditorBg end
	if UI.ConsoleFrame then UI.ConsoleFrame.BackgroundColor3 = t.EditorBg end
	if UI.ThemeBtn then UI.ThemeBtn.Text = "Theme: " .. themeName end
end

--// Glassmorphism Blur Control
