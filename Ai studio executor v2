local function CleanupGC()
	local objCount, connCount, thCount = 0, 0, 0
	for _, obj in ipairs(CollectionService:GetTagged(TAG_MANAGED)) do
		if obj and obj.Parent then
			obj:Destroy()
			objCount += 1
		end
	end
	for _, conn in ipairs(State.TrackedConnections) do
		if conn.Connected then
			conn:Disconnect()
			connCount += 1
		end
	end
	table.clear(State.TrackedConnections)
	for _, th in ipairs(State.TrackedThreads) do
		if coroutine.status(th) ~= "dead" then
			pcall(task.cancel, th)
			thCount += 1
		end
	end
	table.clear(State.TrackedThreads)
	LogConsole("ok", string.format("GC Sweep: %d objects, %d connections, %d threads cleaned.", objCount, connCount, thCount))
end

local function ClearOverlayList()
	for _, child in ipairs(UI.OverlayScroll:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
end

local function OpenOverlay(modeName, titleText)
	State.ActiveOverlay = modeName
	UI.OverlayTitle.Text = titleText
	local showSearch = (modeName == "Hub")
	UI.SearchFrame.Visible = showSearch
	UI.OverlayScroll.Position = UDim2.fromOffset(10, showSearch and 76 or 40)
	UI.OverlayScroll.Size = UDim2.new(1, -20, 1, showSearch and -86 or -50)
	UI.Overlay.Visible = true
	ClearOverlayList()
end

