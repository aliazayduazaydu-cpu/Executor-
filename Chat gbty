--========================================================
-- LOG SYSTEM
--========================================================

local function Log(message, color)
    local entry = {
        Text = tostring(message),
        Time = os.date("%H:%M:%S"),
    }

    table.insert(State.Logs, entry)

    while #State.Logs > CONFIG.MaxLogs do
        table.remove(State.Logs, 1)
    end

    local label = New("TextLabel", {
        Size = UDim2.new(1, -5, 0, 20),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Text = "[" .. entry.Time .. "] " .. entry.Text,
        TextColor3 = color or C.Text,
        Font = Enum.Font.Code,
        TextSize = 11,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top
    }, LogList)

    task.defer(function()
        if LogList.Parent then
            LogList.CanvasPosition = Vector2.new(
                0,
                LogList.AbsoluteCanvasSize.Y
            )
        end
    end)

    local labels = {}

    for _, child in ipairs(LogList:GetChildren()) do
        if child:IsA("TextLabel") then
            table.insert(labels, child)
        end
    end

    while #labels > CONFIG.MaxLogs do
        labels[1]:Destroy()
        table.remove(labels, 1)
    end
end

local function ClearLogs()
    for _, child in ipairs(LogList:GetChildren()) do
        if child:IsA("TextLabel") then
            child:Destroy()
        end
    end

    table.clear(State.Logs)
end

--========================================================
-- SAFE INTERPRETER
--========================================================

local function Interpret(line)
    line = line:match("^%s*(.-)%s*$")

    if line == "" or line:sub(1, 2) == "--" then
        return true
    end

    local value = line:match('^print%(%s*"(.*)"%s*%)$')
        or line:match("^print%(%s*'(.*)'%s*%)$")

    if value ~= nil then
        Log(value, C.Text)
        return true
    end

    value = line:match('^warn%(%s*"(.*)"%s*%)$')
        or line:match("^warn%(%s*'(.*)'%s*%)$")

    if value ~= nil then
        Log("[WARN] " .. value, C.Orange)
        return true
    end

    if line == "clear()" then
        ClearLogs()
        return true
    end

    if line == "help()" then
        Log("Supported commands:", C.Cyan)
        Log('print("text")')
        Log('warn("text")')
        Log("player_info()")
        Log("workspace_info()")
        Log("help()")
        Log("clear()")
        return true
    end

    if line == "player_info()" then
        Log("Player: " .. Player.Name, C.Green)
        Log("UserId: " .. Player.UserId)
        Log("DisplayName: " .. Player.DisplayName)

        return true
    end

    if line == "workspace_info()" then
        Log("Workspace children: " .. #workspace:GetChildren(), C.Green)
        Log("PlaceId: " .. game.PlaceId)
        return true
    end

    return false
end

--========================================================
-- EXECUTION
--========================================================

local function ExecuteCode()
    if State.Running then
        Log("Already running", C.Orange)
        return
    end

    if os.clock() - State.LastClick < CONFIG.Debounce then
        return
    end

    State.LastClick = os.clock()
    State.Running = true
    State.Stopped = false

    local source = Editor.Text
    local lines = {}

    for line in (source .. "\n"):gmatch("(.-)\n") do
        table.insert(lines, line)
    end

    local scriptCopy = source

    table.insert(State.History, 1, {
        Code = scriptCopy,
        Time = os.date("%H:%M:%S")
    })

    while #State.History > CONFIG.MaxHistory do
        table.remove(State.History)
    end

    Log("Execution started", C.Cyan)

    task.spawn(function()
        local errors = 0

        for index, line in ipairs(lines) do
            if State.Stopped or not Screen.Parent then
                break
            end

            local ok, result = pcall(Interpret, line)

            if not ok then
                errors += 1
                Log("Runtime error at line " .. index .. ": " .. tostring(result), C.Red)

            elseif result == false then
                errors += 1
                Log("Unsupported syntax at line " .. index, C.Red)
            end

            task.wait()
        end

        if Screen.Parent then
            if State.Stopped then
                Log("Execution stopped", C.Orange)
            elseif errors == 0 then
                Log("Execution completed", C.Green)
            else
                Log("Completed with " .. errors .. " errors", C.Red)
            end
        end

        State.Running = false
    end)
end

