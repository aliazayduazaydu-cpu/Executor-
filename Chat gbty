    Size = UDim2.new(1, -55, 0, 35),
    BackgroundTransparency = 1,
    Text = "SETTINGS",
    TextColor3 = C.Cyan,
    TextSize = 14,
    Font = Enum.Font.GothamBold,
    TextXAlignment = Enum.TextXAlignment.Left,
    ZIndex = 16
}, Settings)

local SettingsClose = MakeButton(Settings, "×", 32)
SettingsClose.Position = UDim2.new(1, -40, 0, 5)
SettingsClose.ZIndex = 17

local function SettingButton(text, position)
    local button = MakeButton(Settings, text, 190)
    button.Position = position
    button.ZIndex = 17
    return button
end

local FontButton = SettingButton(
    "Font Size: " .. CONFIG.FontSize,
    UDim2.fromOffset(12, 52)
)

local ThemeButton = SettingButton(
    "Theme: " .. CONFIG.Theme,
    UDim2.fromOffset(12, 96)
)

local ConsoleButton = SettingButton(
    "Console: ON",
    UDim2.fromOffset(12, 140)
)

local function ApplyTheme()
    C = THEME[CONFIG.Theme]

    Main.BackgroundColor3 = C.Background
    Header.BackgroundColor3 = C.Panel
    EditorPanel.BackgroundColor3 = C.Editor
    Editor.TextColor3 = C.Text
    Editor.TextSize = CONFIG.FontSize

    ConsolePanel.BackgroundColor3 = C.Panel
    Toolbar.BackgroundColor3 = C.Panel

    Floating.BackgroundColor3 = C.Panel
    Floating.TextColor3 = C.Cyan
end

Track(FontButton.MouseButton1Click:Connect(function()
    CONFIG.FontSize += 1

    if CONFIG.FontSize > 22 then
        CONFIG.FontSize = 11
    end

    Editor.TextSize = CONFIG.FontSize
    FontButton.Text = "Font Size: " .. CONFIG.FontSize
end))

Track(ThemeButton.MouseButton1Click:Connect(function()
    CONFIG.Theme = CONFIG.Theme == "Dark" and "Light" or "Dark"

    ApplyTheme()
    ThemeButton.Text = "Theme: " .. CONFIG.Theme

    Log("Theme changed", C.Cyan)
end))

Track(ConsoleButton.MouseButton1Click:Connect(function()
    CONFIG.ConsoleVisible = not CONFIG.ConsoleVisible

    ConsolePanel.Visible = CONFIG.ConsoleVisible

    ConsoleButton.Text = CONFIG.ConsoleVisible
        and "Console: ON"
        or "Console: OFF"
end))

Track(SettingsButton.MouseButton1Click:Connect(function()
    Settings.Visible = true
end))

Track(SettingsClose.MouseButton1Click:Connect(function()
    Settings.Visible = false
end))

--========================================================
-- KEYBOARD SHORTCUTS
--========================================================

Track(UserInputService.InputBegan:Connect(function(input, processed)
    if processed then
        if input.KeyCode == Enum.KeyCode.Escape then
            CloseUI()
        end

        return
    end

    local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)

    local cmd = UserInputService:IsKeyDown(Enum.KeyCode.LeftMeta)
        or UserInputService:IsKeyDown(Enum.KeyCode.RightMeta)

    if ctrl or cmd then
        if input.KeyCode == Enum.KeyCode.Return then
            ExecuteCode()

        elseif input.KeyCode == Enum.KeyCode.S then
            SaveFile()
        end
    elseif input.KeyCode == Enum.KeyCode.Escape then
        if State.Open then
            CloseUI()
        else
            OpenUI()
        end
    end
end))

