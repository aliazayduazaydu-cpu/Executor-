-- ============================================================
-- UTILITY HELPERS (performance-conscious)
-- ============================================================
local function create(className, props, children)
    local inst = Instance.new(className)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then
            inst[k] = v
        end
    end
    for _, child in ipairs(children or {}) do
        child.Parent = inst
    end
    if props and props.Parent then
        inst.Parent = props.Parent
    end
    return inst
end

local function tween(inst, props, duration, style)
    local info = TweenInfo.new(
        duration or 0.22,
        style or Enum.EasingStyle.Quart,
        Enum.EasingDirection.Out
    )
    local tw = TweenService:Create(inst, info, props)
    tw:Play()
    return tw
end

local function corner(parent, radius)
    return create("UICorner", {
        CornerRadius = UDim.new(0, radius or Config.CornerRadius),
        Parent = parent,
    })
end

local function stroke(parent, color, thickness)
    return create("UIStroke", {
        Color = color or T.Border,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        Parent = parent,
    })
end

local function pad(parent, p)
    return create("UIPadding", {
        PaddingTop = UDim.new(0, p),
        PaddingBottom = UDim.new(0, p),
        PaddingLeft = UDim.new(0, p),
        PaddingRight = UDim.new(0, p),
        Parent = parent,
    })
end

local function gradient(parent, c1, c2, rotation)
    return create("UIGradient", {
        Color = ColorSequence.new(c1 or T.AccentCyan, c2 or T.AccentPurple),
        Rotation = rotation or 90,
        Parent = parent,
    })
end

local function safeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[NexusExecutor] " .. tostring(err))
    end
    return ok, err
end

local function generateId()
    return tostring(os.time()) .. "_" .. tostring(math.random(10000, 99999))
end

