-- Execute with debounce
local lastExec = 0
local function executeCode()
    local now = tick()
    if now - lastExec < (Config.DebounceMs / 1000) then
        log("Please wait before executing again.", "warn")
        return
    end
    lastExec = now

    local code = CodeBox.Text
    if code:gsub("%s", "") == "" then
        log("Nothing to execute.", "warn")
        return
    end

    log("─── EXECUTE ───", "system")

    -- History
    table.insert(State.History, 1, code)
    if #State.History > Config.MaxHistory then
        table.remove(State.History)
    end

    -- Real loadstring path
    if HAS_LOADSTRING then
        local ok, func, err = pcall(function()
            return loadstring(code)
        end)
        if not ok or not func then
            log("Compile error: " .. tostring(err), "error")
            return
        end
        local execOk, runtimeErr = pcall(func)
        if execOk then
            log("Execution completed.", "success")
        else
            log("Runtime error: " .. tostring(runtimeErr), "error")
        end
    else
        -- Simulated path (standard client)
        log("Simulation mode (loadstring unavailable on client).", "warn")
        local count = 0
        for line in code:gmatch("[^\n]+") do
            local msg = line:match('print%s*%(%s*"(.-)"%s*%)')
            if msg then
                log("[OUTPUT] " .. msg, "success")
                count = count + 1
            end
        end
        if count == 0 then
            log("Simulated execution complete.", "success")
        end
    end
    log("────────────────", "system")
end

