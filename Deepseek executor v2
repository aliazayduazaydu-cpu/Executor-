local function renderHubList(results)
    for _, child in ipairs(HubListLayout:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    local y = 0
    for _, hub in ipairs(results) do
        local btn = create("TextButton", {
            Size = UDim2.new(1, -8, 0, 48),
            BackgroundColor3 = T.Surface,
            BackgroundTransparency = 0.2,
            BorderSizePixel = 0,
            Font = F.UIMedium,
            TextSize = 11,
            TextColor3 = T.TextPrimary,
            TextXAlignment = Enum.TextXAlignment.Left,
            Text = "  🌐  " .. hub.name .. "\n     " .. hub.url:sub(1, 40) .. "...",
            AutoButtonColor = false,
            LayoutOrder = y,
            Parent = HubListLayout,
        })
        corner(btn, 6)
        stroke(btn, T.Border, 1)
        btn.MouseButton1Click:Connect(function()
            fetchScript(hub, function(success, code)
                local existing = nil
                for _, s in ipairs(State.Scripts) do
                    if s.name == hub.name then existing = s; break end
                end
                if existing then
                    existing.code = code
                    State.ActiveScriptId = existing.id
                else
                    addScript(hub.name, code)
                end
                CodeBox.Text = code
                switchTab("editor")
                log("Loaded: " .. hub.name, success and "success" or "warn")
            end)
        end)
        y = y + 1
    end
    HubListScroll.CanvasSize = UDim2.new(0, 0, 0, y * 54)
end

HubSearchBtn.MouseButton1Click:Connect(function()
