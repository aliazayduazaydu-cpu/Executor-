local function searchHubs(query)
    query = query:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if query == "" then return SCRIPT_HUBS end
    local results = {}
    for _, hub in ipairs(SCRIPT_HUBS) do
        local match = hub.name:lower():find(query, 1, true)
        if not match then
            for _, tag in ipairs(hub.tags) do
                if tag:find(query, 1, true) then match = true; break end
            end
        end
        if match then table.insert(results, hub) end
    end
    return results
end

-- ============================================================
-- WEB FETCH (simulated on standard client; real if HttpService exposed)
-- ============================================================
local function fetchScript(hub, callback)
    if State.LoadingWeb then
        log("A web request is already in progress.", "warn")
        return
    end
    State.LoadingWeb = true
    log("Fetching: " .. hub.name .. " ...", "system")

    task.spawn(function()
        task.wait(0.7) -- simulated latency

        local realCode = nil
        -- Attempt real HttpService ONLY if the environment exposes it
        local okHttp, http = pcall(function()
            return game:GetService("HttpService")
        end)
        if okHttp and http and http.HttpEnabled then
            local okReq, res = pcall(function()
                return http:GetAsync(hub.url)
            end)
            if okReq and type(res) == "string" and #res > 0 then
                realCode = res
            end
        end

        State.LoadingWeb = false
        if realCode then
            callback(true, realCode)
            log("Fetched live script from web.", "success")
        else
            callback(false, hub.code)
            log("Web APIs unavailable on client. Loaded simulated script.", "warn")
        end
    end)
end

-- ============================================================
-- SCRIPT STORAGE
-- ============================================================
local function storageFolder()
    local f = PlayerGui:FindFirstChild("NexusExecutor_Data")
    if not f then
        f = create("Folder", { Name = "NexusExecutor_Data", Parent = PlayerGui })
    end
    return f
end

local function saveScripts()
    local folder = storageFolder()
    local data = {}
    for _, s in ipairs(State.Scripts) do
        table.insert(data, { id = s.id, name = s.name, code = s.code })
    end
    local json = HttpService:JSONEncode(data)
    local existing = folder:FindFirstChild("SavedScripts")
    if existing then existing:Destroy() end
    create("StringValue", {
        Name = "SavedScripts",
        Value = json,
        Parent = folder,
    })
end

local function loadScripts()
    local folder = PlayerGui:FindFirstChild("NexusExecutor_Data")
    if not folder then return end
    local sv = folder:FindFirstChild("SavedScripts")
    if not sv then return end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(sv.Value)
    end)
    if ok and type(data) == "table" then
        State.Scripts = data
        if #State.Scripts > 0 then
            State.ActiveScriptId = State.Scripts[1].id
        end
    end
end

local function addScript(name, code)
    local s = { id = generateId(), name = name or "Untitled", code = code or "-- New script\n" }
    table.insert(State.Scripts, s)
    State.ActiveScriptId = s.id
    saveScripts()
    return s
end

local function activeScript()
    for _, s in ipairs(State.Scripts) do
        if s.id == State.ActiveScriptId then return s end
    end
    return nil
end

