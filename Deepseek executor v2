local ConsoleScroll, ConsoleLayout

local function log(msg, level)
    level = level or "info"
    local color = T.TextPrimary
    if level == "error" then color = T.AccentRed
    elseif level == "warn" then color = T.AccentYellow
    elseif level == "success" then color = T.AccentGreen
    elseif level == "system" then color = T.AccentCyan
    end

    local entry = {
        text = "[" .. os.date("%H:%M:%S") .. "] " .. tostring(msg),
        color = color,
    }
    table.insert(State.ConsoleLines, entry)
    if #State.ConsoleLines > Config.MaxConsole then
        table.remove(State.ConsoleLines, 1)
    end

    if ConsoleLayout and ConsoleScroll then
        for _, child in ipairs(ConsoleLayout:GetChildren()) do
            if child:IsA("TextLabel") then child:Destroy() end
        end
        for _, line in ipairs(State.ConsoleLines) do
            create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 18),
                BackgroundTransparency = 1,
                Font = F.Code,
                TextSize = 13,
                TextColor3 = line.color,
                TextXAlignment = Enum.TextXAlignment.Left,
                TextTruncate = Enum.TextTruncate.AtEnd,
                Text = line.text,
                Parent = ConsoleLayout,
            })
        end
        task.defer(function()
            if ConsoleScroll then
                ConsoleScroll.CanvasPosition = Vector2.new(
                    0,
                    math.max(0, ConsoleLayout.AbsoluteSize.Y - ConsoleScroll.AbsoluteSize.Y)
                )
            end
        end)
    end
end

