    local toggle = create("TextButton", {
        Size = UDim2.new(0, 44, 0, 24),
        Position = UDim2.new(1, -52, 0.5, -12),
        BackgroundColor3 = defaultValue and T.AccentGreen or T.SurfaceLight,
        BorderSizePixel = 0,
