local function setBlur(on)
    if on then
        if not State.BlurEffect then
            State.BlurEffect = create("BlurEffect", { Name = "Nexus_Blur", Size = 0, Parent = Lighting })
        end
        tween(State.BlurEffect, { Size = 10 }, 0.35)
    elseif State.BlurEffect then
        tween(State.BlurEffect, { Size = 0 }, 0.35)
        task.delay(0.4, function()
            if State.BlurEffect and State.BlurEffect.Size < 1 then
                State.BlurEffect:Destroy()
                State.BlurEffect = nil
            end
        end)
    end
end

-- ============================================================
-- CONSOLE
-- ============================================================
local ConsoleScroll, ConsoleLayout

local function log(msg, level)
    level = level or "info"
    local color = T.TextPrimary
    if level == "error" then color = T.AccentRed
    elseif level == "warn" then color = T.AccentYellow
    elseif level == "success" then color = T.AccentGreen
    elseif level == "system" then color = T.AccentCyan
    end

    table.insert(State.ConsoleLines, { text = "[" .. os.date("%H:%M:%S") .. "] " .. tostring(msg), color = color })
    if #State.ConsoleLines > Config.MaxConsole then table.remove(State.ConsoleLines, 1) end

    if ConsoleLayout and ConsoleScroll then
        for _, c in ipairs(ConsoleLayout:GetChildren()) do
            if c:IsA("TextLabel") then c:Destroy() end
        end
        for _, line in ipairs(State.ConsoleLines) do
            create("TextLabel", {
                Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1,
                Font = Enum.Font.RobotoMono, TextSize = 13, TextColor3 = line.color,
                TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
                Text = line.text, Parent = ConsoleLayout,
            })
        end
        task.defer(function()
            if ConsoleScroll then
                ConsoleScroll.CanvasPosition = Vector2.new(0, math.max(0, ConsoleLayout.AbsoluteSize.Y - ConsoleScroll.AbsoluteSize.Y))
            end
        end)
    end
end

