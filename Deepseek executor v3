local function toolBtn(iconName, label, color, onClick, order, w)
    local btn = create("TextButton", {
        Size = UDim2.new(0, w or 100, 0, 36),
        Position = UDim2.new(0, 8 + order * ((w or 100) + 6), 0.5, -18),
        BackgroundColor3 = color, BorderSizePixel = 0,
        Font = Enum.Font.GothamBold, TextSize = 11,
        TextColor3 = (color == T.SurfaceLight) and T.TextPrimary or Color3.new(0,0,0),
        RichText = true, Text = icon(iconName) .. "  " .. label,
        AutoButtonColor = false, Parent = Toolbar,
    })
    corner(btn, 7)
    local base = color
    btn.MouseEnter:Connect(function()
        tween(btn, { BackgroundColor3 = base:Lerp(Color3.new(1,1,1), 0.15) }, 0.1)
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, { BackgroundColor3 = base }, 0.1)
    end)
    btn.MouseButton1Click:Connect(function() safeCall(onClick) end)
    return btn
end

local lastExec = 0
local function executeCode()
    local now = tick()
    if now - lastExec < 0.4 then log("انتظر قليلًا قبل التنفيذ التالي.", "warn"); return end
    lastExec = now

    local code = CodeBox.Text
    if code:gsub("%s", "") == "" then log("لا يوجد كود.", "warn"); return end

    log("─── تنفيذ ───", "system")
    if HAS_LOADSTRING then
        local ok, func, err = pcall(function() return loadstring(code) end)
        if not ok or not func then log("خطأ في الترجمة: " .. tostring(err), "error"); return end
        local execOk, runtimeErr = pcall(func)
        if execOk then log("تم التنفيذ بنجاح.", "success")
        else log("خطأ وقت التشغيل: " .. tostring(runtimeErr), "error") end
    else
        log("وضع المحاكاة (loadstring غير متاح).", "warn")
        local found = false
        for line in code:gmatch("[^\n]+") do
            local msg = line:match('print%s*%(%s*"(.-)"%s*%)')
            if msg then log("[OUTPUT] " .. msg, "success"); found = true end
        end
        if not found then log("اكتمل التنفيذ المحاكى.", "success") end
    end
    log("────────────────", "system")
end

toolBtn("play", "RUN", T.AccentGreen, executeCode, 0, 90)
