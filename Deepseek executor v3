-- ============================================================
-- KEYBOARD SHORTCUTS
-- ============================================================
UserInputService.InputBegan:Connect(function(input, processed)
    if processed then return end
    local ctrl = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
    if ctrl and input.KeyCode == Enum.KeyCode.Return then executeCode()
    elseif ctrl and input.KeyCode == Enum.KeyCode.S then
        local s = activeScript()
        if s then s.code = CodeBox.Text; saveScripts(); log("تم الحفظ: " .. s.name, "success") end
    elseif input.KeyCode == Enum.KeyCode.Escape then
        if State.IsOpen then
            State.IsOpen = false
            setBlur(false)
            tween(Main, { Size = UDim2.new(0, 0, 0, 0) }, 0.22)
            task.delay(0.25, function() Main.Visible = false; if IS_MOBILE then FloatingBtn.Visible = true end end)
        else
            State.IsOpen = true
            Main.Visible = true
            tween(Main, { Size = UDim2.new(0, Config.WindowWidth, 0, Config.WindowHeight) }, 0.28)
            setBlur(true)
            if IS_MOBILE then FloatingBtn.Visible = false end
        end
    end
end)

