    stroke(card, T.Border, 1)

    -- أيقونة
    local iconLbl = create("TextLabel", {
        Size = UDim2.new(0, 36, 0, 36), Position = UDim2.new(0.5, -18, 0, 8),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 24,
        RichText = true, TextColor3 = T.AccentCyan, Text = icon(hub.icon), Parent = card,
    })

    -- اسم
    create("TextLabel", {
        Size = UDim2.new(1, -8, 0, 16), Position = UDim2.new(0, 4, 1, -34),
        BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 10,
        TextColor3 = T.TextPrimary, TextXAlignment = Enum.TextXAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd, Text = hub.name, Parent = card,
    })

    -- وصف / شارة
    create("TextLabel", {
        Size = UDim2.new(1, -8, 0, 12), Position = UDim2.new(0, 4, 1, -18),
        BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 9,
        TextColor3 = T.AccentPurple, TextXAlignment = Enum.TextXAlignment.Center,
        Text = hub.desc, Parent = card,
    })

    -- تأثير Hover
    card.MouseEnter:Connect(function()
        tween(card, { BackgroundColor3 = T.SurfaceLight, BackgroundTransparency = 0.02 }, 0.15)
        tween(iconLbl, { TextColor3 = T.AccentGreen }, 0.15)
    end)
    card.MouseLeave:Connect(function()
        tween(card, { BackgroundColor3 = T.Surface, BackgroundTransparency = 0.1 }, 0.15)
        tween(iconLbl, { TextColor3 = T.AccentCyan }, 0.15)
    end)

    card.MouseButton1Click:Connect(function()
        log("تحميل: " .. hub.name, "system")
        task.wait(0.3) -- محاكاة تحميل
        local existing = nil
        for _, s in ipairs(State.Scripts) do
            if s.name == hub.name then existing = s; break end
        end
        if existing then
            existing.code = hub.code
            State.ActiveScriptId = existing.id
        else
            addScript(hub.name, hub.code)
        end
        CodeBox.Text = hub.code
        switchTab("editor")
        log("تم التحميل: " .. hub.name, "success")
    end)

    return card
end

local function renderHubGrid(results)
    for _, c in ipairs(HubGridScroll:GetChildren()) do
        if c:IsA("TextButton") then c:Destroy() end
    end
    for i, hub in ipairs(results) do
        makeHubCard(hub, i)
    end
end

