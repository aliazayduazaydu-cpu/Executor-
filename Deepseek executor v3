local function searchHubs(q)
    q = q:lower():gsub("^%s+", ""):gsub("%s+$", "")
    if q == "" then return HUBS end
    local res = {}
    for _, h in ipairs(HUBS) do
        if h.name:lower():find(q, 1, true) or h.desc:lower():find(q, 1, true) then
            table.insert(res, h)
        end
    end
    return res
end

