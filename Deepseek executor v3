-- صفوف الإعدادات
local function settingRow(label, default, callback)
    local row = create("Frame", {
        Size = UDim2.new(1, -8, 0, 42), BackgroundColor3 = T.Surface,
        BackgroundTransparency = 0.2, BorderSizePixel = 0, Parent = SettingsLayout,
    })
    corner(row, 8)
    create("TextLabel", {
        Size = UDim2.new(1, -70, 1, 0), Position = UDim2.new(0, 12, 0, 0),
        BackgroundTransparency = 1, Font = Enum.Font.GothamMedium, TextSize = 12,
        TextColor3 = T.TextPrimary, TextXAlignment = Enum.TextXAlignment.Left,
        Text = label, Parent = row,
    })
    local state = default
    local tog = create("TextButton", {
        Size = UDim2.new(0, 50, 0, 26), Position = UDim2.new(1, -58, 0.5, -13),
        BackgroundColor3 = state and T.AccentGreen or T.SurfaceLight,
        BorderSizePixel = 0, Font = Enum.Font.GothamBold, TextSize = 10,
        TextColor3 = state and Color3.new(0,0,0) or T.TextSecondary,
        Text = state and "ON" or "OFF", AutoButtonColor = false, Parent = row,
    })
    corner(tog, 13)
    tog.MouseButton1Click:Connect(function()
        state = not state
        tog.BackgroundColor3 = state and T.AccentGreen or T.SurfaceLight
        tog.Text = state and "ON" or "OFF"
        tog.TextColor3 = state and Color3.new(0,0,0) or T.TextSecondary
        safeCall(callback, state)
    end)
end

