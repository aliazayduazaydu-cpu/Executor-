local function new(class, props, parent)
    local i = Instance.new(class)
    for k, v in pairs(props or {}) do i[k] = v end
    if parent then i.Parent = parent end
    return i
end

local function corner(inst, r) return new("UICorner", {CornerRadius = UDim.new(0, r or 10)}, inst) end
local function stroke(inst, color, thick) return new("UIStroke", {Color = color or C.border, Thickness = thick or 1}, inst) end
local function padding(inst, p) 
    return new("UIPadding", {
        PaddingTop = UDim.new(0,p), PaddingBottom = UDim.new(0,p),
        PaddingLeft = UDim.new(0,p), PaddingRight = UDim.new(0,p)
    }, inst) 
end

