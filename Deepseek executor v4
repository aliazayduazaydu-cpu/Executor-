-- زر التشغيل
local function executeCode(code)
    if not code or code:gsub("%s", "") == "" then
        return false, "لا يوجد كود للتنفيذ"
    end
    local ls = loadstring or (getfenv and rawget(_G, "loadstring"))
    if not ls then
        return false, "loadstring غير متاح في هذه البيئة (Client عادي)."
    end
    local fn, err = pcall(ls, code)
    if not fn then
        return false, "خطأ في الترجمة: " .. tostring(err)
    end
    local ok, result = pcall(fn)
    if not ok then
        return false, "خطأ في التنفيذ: " .. tostring(result)
    end
    return true, "تم التنفيذ بنجاح ✅"
end

execBtn.MouseButton1Click:Connect(function()
    local ok, msg = executeCode(codeBox.Text)
    toast(msg, not ok)
end)

