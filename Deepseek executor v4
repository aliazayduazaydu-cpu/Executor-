--==========================================================================
local function toast(msg, isError)
    local t = new("TextLabel", {
        Size = UDim2.new(0, 280, 0, 44),
        Position = UDim2.new(0.5, 0, 0, -60),
        AnchorPoint = UDim2.new(0.5, 0, 0, 0),
        BackgroundColor3 = isError and C.danger or C.good,
        BackgroundTransparency = 0.05,
        TextColor3 = C.text,
        Font = Enum.Font.GothamBold,
        TextSize = 14,
        Text = msg,
        ZIndex = 50,
    }, gui)
    corner(t, 10)
    stroke(t, Color3.new(1,1,1), 1).Transparency = 0.7
    TweenService:Create(t, TweenInfo.new(0.3, Enum.EasingStyle.Quart), {
        Position = UDim2.new(0.5, 0, 0, 20)
    }):Play()
    task.delay(2.4, function()
        local tw = TweenService:Create(t, TweenInfo.new(0.3), {
            Position = UDim2.new(0.5, 0, 0, -60)
        })
        tw:Play()
        tw.Completed:Connect(function() t:Destroy() end)
    end)
end

