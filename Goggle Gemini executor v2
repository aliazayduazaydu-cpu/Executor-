-- ============================================================================
-- 2. ExecuteCode(): COROUTINE-WRAPPED EXECUTION WITH LINE-NUMBER ERRORS
-- ============================================================================
local function ExecuteCode(sourceCode: string, label: string?)
	if State.ExecDebounce then
		return
	end
	State.ExecDebounce = true
	task.delay(0.2, function()
		State.ExecDebounce = false
	end)

	local theme = GetTheme()
	if not sourceCode or sourceCode:gsub("%s+", "") == "" then
		LogConsole("Nothing to execute (editor is empty).", theme.Warn)
		return
	end

	-- Record into 10-item Execution History
	table.insert(ExecutionHistory, 1, {
		Title = label or ("Snippet #" .. tostring(#ExecutionHistory + 1)),
		Code = sourceCode,
		Time = os.date("%H:%M:%S"),
	})
	if #ExecutionHistory > 10 then
		table.remove(ExecutionHistory)
	end

	-- Check if loadstring is enabled in this Roblox experience
	if typeof(loadstring) ~= "function" then
		LogConsole("Execution skipped: loadstring() is disabled in this game client.", theme.Warn)
		return
	end

	-- Compile Lua string and extract exact line number on syntax failure
	local compiledFn, compileErr = loadstring(sourceCode, "=NexusUserScript")
	if not compiledFn then
		local errStr = tostring(compileErr)
		local lineNum = errStr:match(":(%d+):") or "?"
		LogConsole(string.format("Syntax Error (Line %s): %s", lineNum, errStr), theme.Error)
		return
	end

	-- Build safe sandbox environment with GC tracking helpers
	local sandboxEnv = {
		print = function(...)
			local out = {}
			for i = 1, select("#", ...) do
				table.insert(out, tostring(select(i, ...)))
			end
			LogConsole(table.concat(out, "  "), theme.TextMain)
		end,
		warn = function(...)
			local out = {}
			for i = 1, select("#", ...) do
				table.insert(out, tostring(select(i, ...)))
			end
			LogConsole("WARN: " .. table.concat(out, "  "), theme.Warn)
		end,
		Player = LocalPlayer,
		Players = Players,
		Workspace = Workspace,
		ReplicatedStorage = ReplicatedStorage,
		TweenService = TweenService,
		UserInputService = UserInputService,
		Track = function(inst: Instance)
			CollectionService:AddTag(inst, TAG_GC_MANAGED)
			table.insert(RuntimeGC.Instances, inst)
			return inst
		end,
		Connect = function(conn: RBXScriptConnection)
			table.insert(RuntimeGC.Connections, conn)
			return conn
		end,
		task = task,
		coroutine = coroutine,
		Instance = Instance,
		Vector3 = Vector3,
		CFrame = CFrame,
		Color3 = Color3,
		UDim2 = UDim2,
		Enum = Enum,
		math = math,
		string = string,
		table = table,
		pairs = pairs,
		ipairs = ipairs,
		tostring = tostring,
		tonumber = tonumber,
		type = type,
		typeof = typeof,
		pcall = pcall,
	}
	setmetatable(sandboxEnv, { __index = _G })
	pcall(setfenv, compiledFn, sandboxEnv)

	-- Run inside coroutine.wrap so heavy scripts never freeze the UI thread
	local runner = coroutine.wrap(function()
		local ok, runtimeErr = xpcall(compiledFn, function(err)
			return debug.traceback(tostring(err), 2)
		end)
		if not ok then
			local errText = tostring(runtimeErr)
			local lineNum = errText:match(":(%d+):") or "?"
			LogConsole(string.format("Runtime Error (Line %s): %s", lineNum, errText), theme.Error)
		else
			LogConsole("Executed successfully.", theme.Success)
		end
	end)

	runner()
end

-- ============================================================================
-- 3. FetchScripts(): WEB SCRIPT HUB & REMOTE PROXY FETCHER
-- ============================================================================
--[[
	How Web Fetch works safely in a LocalScript:
	1. Roblox blocks HttpService:GetAsync() directly inside LocalScripts.
	2. If a Server Script exposes a RemoteFunction named "NexusWebFetch" in
	   ReplicatedStorage, this function invokes it to fetch live Pastebin/GitHub
	   raw endpoints.
	3. Otherwise, it searches the built-in UniversalCatalog asynchronously so
	   the Hub works out-of-the-box with zero errors.
]]
local function FetchScripts(query: string, callback: ({ any }) -> ())
	task.spawn(function()
		task.wait(0.25) -- Smooth async yield so UI stays responsive

		local proxy = ReplicatedStorage:FindFirstChild("NexusWebFetch")
		if proxy and proxy:IsA("RemoteFunction") then
			local ok, remoteData = pcall(function()
				return proxy:InvokeServer(query)
			end)
			if ok and type(remoteData) == "table" then
				callback(remoteData)
				return
			end
		end

		local q = string.lower((query or ""):gsub("^%s+", ""):gsub("%s+$", ""))
		if q == "" then
			callback(UniversalCatalog)
			return
		end

		local filtered = {}
		for _, item in ipairs(UniversalCatalog) do
			local searchBlob = string.lower(item.Title .. " " .. item.Source .. " " .. table.concat(item.Tags, " "))
			if string.find(searchBlob, q, 1, true) then
				table.insert(filtered, item)
			end
		end
		callback(filtered)
	end)
end

