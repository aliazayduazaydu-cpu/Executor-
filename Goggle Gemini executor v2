local function GetTheme()
	return THEMES[State.ThemeName] or THEMES.Dark
end

local function LogConsole(message: string, color: Color3?)
	if not UI.ConsoleScroll then
		return
	end
	local theme = GetTheme()
	local entry = Instance.new("TextLabel")
	entry.Size = UDim2.new(1, -8, 0, 0)
	entry.AutomaticSize = Enum.AutomaticSize.Y
	entry.BackgroundTransparency = 1
	entry.TextWrapped = true
	entry.TextXAlignment = Enum.TextXAlignment.Left
	entry.Font = Enum.Font.Code
	entry.TextSize = math.max(11, State.FontSize - 1)
	entry.TextColor3 = color or theme.TextMain
	entry.Text = string.format("[%s] %s", os.date("%H:%M:%S"), message)
	entry.Parent = UI.ConsoleScroll

	-- Keep console capped at 80 lines to guarantee <1% CPU & low memory
	local children = UI.ConsoleScroll:GetChildren()
	if #children > 82 then
		for _, child in ipairs(children) do
			if child:IsA("TextLabel") then
				child:Destroy()
				break
			end
		end
	end

	task.defer(function()
		if UI.ConsoleScroll then
			UI.ConsoleScroll.CanvasPosition = Vector2.new(0, 999999)
		end
	end)
end

local function CleanupRuntime()
	local swept = 0
	for _, conn in ipairs(RuntimeGC.Connections) do
		if conn.Connected then
			conn:Disconnect()
			swept += 1
		end
	end
	table.clear(RuntimeGC.Connections)

	for _, co in ipairs(RuntimeGC.Threads) do
		if coroutine.status(co) ~= "dead" then
			pcall(task.cancel, co)
			swept += 1
		end
	end
	table.clear(RuntimeGC.Threads)

	for _, inst in ipairs(RuntimeGC.Instances) do
		if inst and inst.Parent then
			pcall(inst.Destroy, inst)
			swept += 1
		end
	end
	table.clear(RuntimeGC.Instances)

	for _, tagged in ipairs(CollectionService:GetTagged(TAG_GC_MANAGED)) do
		if tagged and tagged.Parent then
			pcall(tagged.Destroy, tagged)
			swept += 1
		end
	end

	LogConsole(string.format("Stopped execution & garbage-collected %d handles.", swept), GetTheme().Success)
end

local function ApplyTheme()
	local t = GetTheme()
	for _, inst in ipairs(CollectionService:GetTagged(TAG_UI_THEME_BG)) do
		if inst:IsA("GuiObject") then
			inst.BackgroundColor3 = t.BgBase
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged(TAG_UI_THEME_PANEL)) do
		if inst:IsA("GuiObject") then
			inst.BackgroundColor3 = t.BgPanel
		end
	end
	for _, inst in ipairs(CollectionService:GetTagged(TAG_UI_THEME_TEXT)) do
		if inst:IsA("TextLabel") or inst:IsA("TextBox") or inst:IsA("TextButton") then
			inst.TextColor3 = t.TextMain
		end
	end
	if UI.CodeEditor then
		UI.CodeEditor.TextSize = State.FontSize
	end
end

