local function SetMinimized(minimized: boolean)
	State.IsMinimized = minimized
	if minimized then
		UI.MainWindow.Visible = false
		UI.TogglePill.Visible = true
		TweenService:Create(UI.Blur, TweenInfo.new(0.2), { Size = 0 }):Play()
	else
		UI.TogglePill.Visible = false
		UI.MainWindow.Visible = true
		TweenService:Create(UI.Blur, TweenInfo.new(0.25), { Size = 6 }):Play()
	end
end

local function SaveCurrentScript()
	local code = UI.CodeEditor.Text
	if code:gsub("%s+", "") == "" then
		LogConsole("Cannot save an empty script.", GetTheme().Warn)
		return
	end
	local slotName = "SavedScript_" .. os.date("%H%M%S") .. ".luau"
	SavedScripts[slotName] = code

	-- Optional Server DataStore bridge if present
	local dsRemote = ReplicatedStorage:FindFirstChild("NexusSaveScript")
	if dsRemote and dsRemote:IsA("RemoteEvent") then
		pcall(function()
			dsRemote:FireServer(slotName, code)
		end)
	end

	LogConsole("Saved locally as '" .. slotName .. "'.", GetTheme().Success)
end

local function SetupEvents()
	-- Toolbar Actions
	UI.ExecBtn.MouseButton1Click:Connect(function()
		ExecuteCode(UI.CodeEditor.Text, "Editor Script")
	end)
	UI.StopBtn.MouseButton1Click:Connect(CleanupRuntime)
	UI.ClearBtn.MouseButton1Click:Connect(function()
		for _, ch in ipairs(UI.ConsoleScroll:GetChildren()) do
			if ch:IsA("TextLabel") then
				ch:Destroy()
			end
		end
	end)
	UI.SaveBtn.MouseButton1Click:Connect(SaveCurrentScript)
	UI.LoadBtn.MouseButton1Click:Connect(OpenLoadDrawer)
	UI.HubBtn.MouseButton1Click:Connect(OpenHubDrawer)
	UI.SettingsBtn.MouseButton1Click:Connect(OpenSettingsDrawer)
	UI.DrawerClose.MouseButton1Click:Connect(function()
		UI.Drawer.Visible = false
	end)

	-- Window Minimize / Maximize / Close
	UI.MinBtn.MouseButton1Click:Connect(function()
		SetMinimized(true)
	end)
	UI.CloseBtn.MouseButton1Click:Connect(function()
		SetMinimized(true)
	end)
	UI.TogglePill.MouseButton1Click:Connect(function()
		SetMinimized(false)
	end)
	UI.MaxBtn.MouseButton1Click:Connect(function()
		State.IsMaximized = not State.IsMaximized
		if State.IsMaximized then
			State.SavedRect.Pos = UI.MainWindow.Position
			State.SavedRect.Size = UI.MainWindow.Size
			TweenService:Create(UI.MainWindow, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
				Position = UDim2.fromScale(0.5, 0.52),
				Size = UDim2.fromScale(0.95, 0.88),
			}):Play()
		else
			TweenService:Create(UI.MainWindow, TweenInfo.new(0.2, Enum.EasingStyle.Quint), {
				Position = State.SavedRect.Pos,
				Size = State.SavedRect.Size,
			}):Play()
		end
	end)

	-- Touch & Mouse Dragging on Header Bar
	do
		local dragging = false
		local dragInput: InputObject?
		local dragStart: Vector3?
		local startPos: UDim2?

		UI.Header.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				dragging = true
				dragInput = input
				dragStart = input.Position
				startPos = UI.MainWindow.Position
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if dragging and dragStart and startPos then
				if input == dragInput or input.UserInputType == Enum.UserInputType.MouseMovement then
					local delta = input.Position - dragStart
					UI.MainWindow.Position = UDim2.new(
						startPos.X.Scale,
						startPos.X.Offset + delta.X,
						startPos.Y.Scale,
						startPos.Y.Offset + delta.Y
					)
				end
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input == dragInput then
				dragging = false
				dragInput = nil
			end
		end)
	end

	-- Desktop Corner Resizing
	if UI.ResizeHandle then
		local resizing = false
		local startMouse: Vector3?
		local startAbsSize: Vector2?

		UI.ResizeHandle.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = true
				startMouse = input.Position
				startAbsSize = UI.MainWindow.AbsoluteSize
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if resizing and startMouse and startAbsSize and input.UserInputType == Enum.UserInputType.MouseMovement then
				local delta = input.Position - startMouse
				UI.MainWindow.Size = UDim2.fromOffset(
					math.max(360, startAbsSize.X + delta.X),
					math.max(300, startAbsSize.Y + delta.Y)
				)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 then
				resizing = false
			end
		end)
	end

	-- Desktop Keyboard Shortcuts (Ctrl/Cmd+Enter, Ctrl/Cmd+S, Escape)
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if input.KeyCode == Enum.KeyCode.Escape then
			if not gameProcessed then
				SetMinimized(not State.IsMinimized)
			end
			return
		end

		local modHeld = UserInputService:IsKeyDown(Enum.KeyCode.LeftControl)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightControl)
			or UserInputService:IsKeyDown(Enum.KeyCode.LeftSuper)
			or UserInputService:IsKeyDown(Enum.KeyCode.RightSuper)

		if not modHeld then
			return
		end

		if input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter then
			ExecuteCode(UI.CodeEditor.Text, "Shortcut Run")
		elseif input.KeyCode == Enum.KeyCode.S then
			SaveCurrentScript()
		end
	end)
end

