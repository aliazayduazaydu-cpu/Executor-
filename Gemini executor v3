-- 6. التحكم في التبويبات وفتح/إغلاق القائمة المنسدلة بسلاسة
local function setActiveTab(activeBtn, targetPage)
	local tabs = {
		{ btn = TabExecuteBtn, page = ExecutePage },
		{ btn = TabSavedBtn, page = SavedPage },
		{ btn = TabLearnBtn, page = LearnPage }
	}
	for _, t in ipairs(tabs) do
		local isSelected = (t.btn == activeBtn)
		t.page.Visible = isSelected
		t.btn.BackgroundColor3 = isSelected and Theme.RobloxBlue or Theme.CardBg
		t.btn.TextColor3 = isSelected and Theme.TextWhite or Theme.TextMuted
	end
end

