local function updateFilterButtons()
	FilterAllBtn.BackgroundColor3 = (FilterMode == "ALL") and ClassicTheme.Blue or ClassicTheme.Item
	FilterScriptsBtn.BackgroundColor3 = (FilterMode == "Script") and ClassicTheme.Blue or ClassicTheme.Item
	FilterLessonsBtn.BackgroundColor3 = (FilterMode == "Lesson") and ClassicTheme.Blue or ClassicTheme.Item
end

local function rebuildLearnList(filterText)
	local query = filterText and filterText:lower():match("^%s*(.-)%s*$") or ""
	for _, child in ipairs(LearnScroll:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	local rendered = 0
	for _, item in ipairs(LearnScripts) do
		local kindMatches = (FilterMode == "ALL") or (item.Kind == FilterMode)
		local textMatches = (query == "")
			or item.Title:lower():find(query, 1, true) ~= nil
			or item.Desc:lower():find(query, 1, true) ~= nil

		if kindMatches and textMatches then
			rendered += 1
			if rendered <= 120 or query ~= "" or FilterMode ~= "ALL" then
				local card = Instance.new("Frame")
				card.Size = UDim2.new(1, -8, 0, 40)
				card.Position = UDim2.new(0, 4, 0, 0)
				card.BackgroundColor3 = ClassicTheme.Item
				card.Parent = LearnScroll
				sharpCorner(card, 3)

				local tLbl = Instance.new("TextLabel")
				tLbl.Size = UDim2.new(0.62, -6, 0, 18)
				tLbl.Position = UDim2.new(0, 6, 0, 2)
				tLbl.BackgroundTransparency = 1
				tLbl.Text = item.Title
				tLbl.TextColor3 = ClassicTheme.Text
				tLbl.Font = Enum.Font.SourceSansBold
				tLbl.TextSize = 12
				tLbl.TextXAlignment = Enum.TextXAlignment.Left
				tLbl.TextTruncate = Enum.TextTruncate.AtEnd
				tLbl.Parent = card

				local dLbl = Instance.new("TextLabel")
				dLbl.Size = UDim2.new(0.62, -6, 0, 15)
				dLbl.Position = UDim2.new(0, 6, 0, 21)
				dLbl.BackgroundTransparency = 1
				dLbl.Text = item.Desc
				dLbl.TextColor3 = ClassicTheme.SubText
				dLbl.Font = Enum.Font.SourceSans
				dLbl.TextSize = 11
				dLbl.TextXAlignment = Enum.TextXAlignment.Left
				dLbl.TextTruncate = Enum.TextTruncate.AtEnd
				dLbl.Parent = card

				local copyBtn = Instance.new("TextButton")
				copyBtn.Size = UDim2.new(0.17, -3, 0, 24)
				copyBtn.Position = UDim2.new(0.63, 0, 0.5, -12)
				copyBtn.Text = "نسخ"
				copyBtn.Parent = card
				styleBtn(copyBtn, ClassicTheme.Blue, ClassicTheme.BlueHover)

				local runLearnBtn = Instance.new("TextButton")
				runLearnBtn.Size = UDim2.new(0.18, -2, 0, 24)
				runLearnBtn.Position = UDim2.new(0.81, 0, 0.5, -12)
				runLearnBtn.Text = "تشغيل"
				runLearnBtn.Parent = card
				styleBtn(runLearnBtn, ClassicTheme.Green, ClassicTheme.GreenHover)

				copyBtn.MouseButton1Click:Connect(function()
					CodeBox.Text = item.Code
					StatusLbl.Text = "تم نسخ العنصر #" .. tostring(rendered)
					StatusLbl.TextColor3 = ClassicTheme.BlueHover
				end)

				runLearnBtn.MouseButton1Click:Connect(function()
					CodeBox.Text = item.Code
					executeLuau(item.Code)
				end)
			end
		end
	end

	task.defer(function()
		LearnScroll.CanvasSize = UDim2.new(0, 0, 0, LearnLayout.AbsoluteContentSize.Y + 8)
	end)
end

