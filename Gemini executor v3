local function sortSavedScripts()
	table.sort(SavedScripts, function(a, b)
		if a.Pinned ~= b.Pinned then
			return (a.Pinned == true)
		end
		return false
	end)
end

local function saveOrUpdateScript(name, code)
	local cleanName = name and name:match("^%s*(.-)%s*$") or ""
	if cleanName == "" then
		cleanName = "سكربت #" .. tostring(#SavedScripts + 1)
	end

	for _, item in ipairs(SavedScripts) do
		if item.Name == cleanName then
			item.Code = code
			sortSavedScripts()
			return cleanName, true
		end
	end

	table.insert(SavedScripts, {
		Name = cleanName,
		Pinned = false,
		Code = code
	})
	sortSavedScripts()
	return cleanName, false
end

