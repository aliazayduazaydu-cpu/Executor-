local function executeLuau(src)
	if not src or src:match("^%s*$") then
		StatusLbl.Text = "الحقل فارغ"
		StatusLbl.TextColor3 = ClassicTheme.SubText
		return
	end

	clearErrorBox()

	local trimmed = src:match("^%s*(.-)%s*$")
	local codeToRun = trimmed:match("^https?://") and string.format('loadstring(game:HttpGet(%q))()', trimmed) or src

	local loader = loadstring
	if not loader then
		reportError("loadstring غير مفعّل على العميل. فعّل LoadStringEnabled في ServerScriptService.", "loadstring غير مفعّل")
		return
	end

	local compiled, syntaxErr = loader(codeToRun)
	if not compiled then
		reportError("Syntax Error: " .. tostring(syntaxErr), "خطأ في الصياغة")
		return
	end

	local env = setmetatable({
		game = game,
		workspace = workspace,
		script = script,
		print = print,
		warn = warn
	}, { __index = getfenv and getfenv(0) or _G })

	if setfenv then
		pcall(setfenv, compiled, env)
	end

	local ok, runtimeErr = pcall(compiled)
	if ok then
		StatusLbl.Text = "تم التشغيل بنجاح"
		StatusLbl.TextColor3 = ClassicTheme.GreenHover
	else
		reportError("Runtime Error: " .. tostring(runtimeErr), "خطأ أثناء التنفيذ")
	end
end

