SaveBtn.MouseButton1Click:Connect(function()
	-- استيراد تلقائي إذا كان المستخدم قد لصق JSON في صندوق JSON المفتوح
	if JsonBox.Visible and not JsonBox.Text:match("^%s*$") then
		local okDecode, decoded = pcall(function()
			return HttpService:JSONDecode(JsonBox.Text)
		end)
		if okDecode and type(decoded) == "table" then
			local importedCount = 0
			for _, row in ipairs(decoded) do
				if type(row) == "table" and type(row.Name) == "string" and type(row.Code) == "string" then
					saveOrUpdateScript(row.Name, row.Code)
					importedCount += 1
				end
			end
			if importedCount > 0 then
				JsonBox.Text = ""
				JsonBox.Visible = false
				SavedScroll.Size = UDim2.new(1, 0, 1, -36)
				SavedScroll.Position = UDim2.new(0, 0, 0, 36)
				rebuildSavedList()
				StatusLbl.Text = "تم استيراد " .. tostring(importedCount) .. " سكربت"
				StatusLbl.TextColor3 = ClassicTheme.GreenHover
				return
			end
		end
	end

	local codeVal = CodeBox.Text
	if not codeVal or codeVal:match("^%s*$") then
		StatusLbl.Text = "لا يوجد كود لحفظه"
		StatusLbl.TextColor3 = ClassicTheme.RedHover
		return
	end

	local finalName, replaced = saveOrUpdateScript(SaveNameBox.Text, codeVal)
	SaveNameBox.Text = ""
	rebuildSavedList()
	StatusLbl.Text = replaced and ("تم تحديث: " .. finalName) or ("تم حفظ: " .. finalName)
	StatusLbl.TextColor3 = ClassicTheme.GreenHover
end)

