-- 7. التبديل بين التبويبات والطي والفتح بحجم مستقر
local function selectTab(activeBtn, page)
	local map = {
		{ btn = TabExec, p = ExecPage },
		{ btn = TabSaved, p = SavedPage },
		{ btn = TabLearn, p = LearnPage }
	}
	for _, entry in ipairs(map) do
		local selected = (entry.btn == activeBtn)
		entry.p.Visible = selected
		entry.btn.BackgroundColor3 = selected and ClassicTheme.Blue or ClassicTheme.Item
		entry.btn.TextColor3 = selected and ClassicTheme.Text or ClassicTheme.SubText
	end
end

