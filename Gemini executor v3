local isCollapsed = false

local function getExpandedSize()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1024, 600)
	if vp.X < 540 then
		return UDim2.new(0, math.max(280, vp.X - 28), 0, math.min(310, vp.Y - 95))
	end
	return UDim2.new(0, 430, 0, 320)
end

local function getCollapsedSize()
	local exp = getExpandedSize()
	return UDim2.new(0, exp.X.Offset, 0, 40)
end

local function syncFrameSize()
	MainFrame.Size = isCollapsed and getCollapsedSize() or getExpandedSize()
end

