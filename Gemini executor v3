local isOpen = false
local function toggleMenu()
	isOpen = not isOpen
	local fullSize = isCollapsed and getCollapsedSize() or getExpandedSize()

	if isOpen then
		MainFrame.Size = UDim2.new(0, fullSize.X.Offset, 0, 0)
		MainFrame.Visible = true
		TweenService:Create(MainFrame, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = fullSize
		}):Play()
	else
		local closeTw = TweenService:Create(MainFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = UDim2.new(0, fullSize.X.Offset, 0, 0)
		})
		closeTw:Play()
		closeTw.Completed:Connect(function()
			if not isOpen then
				MainFrame.Visible = false
				MainFrame.Size = fullSize
			end
		end)
	end
end

