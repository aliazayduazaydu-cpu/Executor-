				StatusLbl.Text = "تم استيراد " .. tostring(importedCount)
				StatusLbl.TextColor3 = ClassicTheme.GreenHover
				return
			end
		else
			reportError("JSON غير صالح للاستيراد.", "خطأ في JSON")
		end
	end

	local codeVal = CodeBox.Text
	if not codeVal or codeVal:match("^%s*$") then
		StatusLbl.Text = "لا يوجد كود لحفظه"
		StatusLbl.TextColor3 = ClassicTheme.RedHover
		return
