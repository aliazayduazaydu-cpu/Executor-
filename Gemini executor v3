	if JsonBox.Visible and not JsonBox.Text:match("^%s*$") then
		local okDecode, decoded = pcall(function()
			return HttpService:JSONDecode(JsonBox.Text)
		end)
		if okDecode and type(decoded) == "table" then
			local importedCount = 0
			for _, row in ipairs(decoded) do
				if type(row) == "table" and type(row.Name) == "string" and type(row.Code) == "string" then
					saveOrUpdateScript(row.Name, row.Code)
					importedCount += 1
				end
			end
			if importedCount > 0 then
				JsonBox.Text = ""
				JsonBox.Visible = false
				SavedScroll.Size = UDim2.new(1, 0, 1, -34)
				SavedScroll.Position = UDim2.new(0, 0, 0, 34)
