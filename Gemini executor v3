local isCollapsed = false
local isOpen = false
local activeSizeTween = nil

local function getExpandedSize()
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1024, 600)
	if vp.X < 540 then
		return UDim2.new(0, math.max(270, vp.X - 20), 0, math.min(315, vp.Y - 66))
	end
	return UDim2.new(0, 430, 0, 325)
end

local function getCollapsedSize()
	local exp = getExpandedSize()
	return UDim2.new(0, exp.X.Offset, 0, 36)
end

local function getActiveTargetSize()
	return isCollapsed and getCollapsedSize() or getExpandedSize()
end

local TabsRow
local BodyArea

local function applyFrameState(animate)
	if activeSizeTween then
		activeSizeTween:Cancel()
		activeSizeTween = nil
	end

	if not isOpen then
		MainFrame.Visible = false
		return
	end

	local targetSize = getActiveTargetSize()
	MainFrame.Visible = true
	if TabsRow and BodyArea then
		TabsRow.Visible = not isCollapsed
		BodyArea.Visible = not isCollapsed
	end

	if animate then
		activeSizeTween = TweenService:Create(
			MainFrame,
			TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Size = targetSize }
		)
		activeSizeTween:Play()
		activeSizeTween.Completed:Connect(function(playbackState)
			if playbackState == Enum.PlaybackState.Completed and isOpen then
				MainFrame.Size = getActiveTargetSize()
				clampToViewport(MainFrame)
			end
		end)
	else
		MainFrame.Size = targetSize
		clampToViewport(MainFrame)
	end
end

if workspace.CurrentCamera then
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		clampToViewport(ToggleBtn)
		if isOpen then
			applyFrameState(false)
		end
	end)
end

