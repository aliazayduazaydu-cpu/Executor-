	c.Parent = obj
end

local function classicBorder(obj, col, t)
	local s = Instance.new("UIStroke")
	s.Color = col or ClassicTheme.Border
	s.Thickness = t or 1
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = obj
end

local function styleBtn(btn, baseCol, hoverCol)
	btn.BackgroundColor3 = baseCol
	btn.TextColor3 = ClassicTheme.Text
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 13
	btn.AutoButtonColor = false
	sharpCorner(btn, 3)
	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = hoverCol end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = baseCol end)
end

-- إبقاء العناصر داخل الشاشة دون أن تختفي في الزوايا
local function clampToViewport(guiObj)
	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1024, 600)
	local margin = 6
	local w = guiObj.Size.X.Offset
	local h = guiObj.Size.Y.Offset

	local maxX = math.max(margin, vp.X - w - margin)
	local maxY = math.max(margin, vp.Y - h - margin)

	local clampedX = math.clamp(guiObj.Position.X.Offset, margin, maxX)
	local clampedY = math.clamp(guiObj.Position.Y.Offset, margin, maxY)

	guiObj.Position = UDim2.new(0, clampedX, 0, clampedY)
end

