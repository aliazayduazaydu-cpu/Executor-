local function refreshSavedList()
	for _, child in ipairs(SavedList:GetChildren()) do
		if child:IsA("Frame") then
			child:Destroy()
		end
	end

	for index, item in ipairs(SavedScripts) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -12, 0, 42)
		row.Position = UDim2.new(0, 6, 0, 0)
		row.BackgroundColor3 = Theme.CardBg
		row.Parent = SavedList
		addCorner(row, 8)

		local titleLbl = Instance.new("TextLabel")
		titleLbl.Size = UDim2.new(0.54, -8, 1, 0)
		titleLbl.Position = UDim2.new(0, 10, 0, 0)
		titleLbl.BackgroundTransparency = 1
		titleLbl.Text = item.Name
		titleLbl.TextColor3 = Theme.TextWhite
		titleLbl.Font = Enum.Font.GothamBold
		titleLbl.TextSize = 12
		titleLbl.TextXAlignment = Enum.TextXAlignment.Left
		titleLbl.TextTruncate = Enum.TextTruncate.AtEnd
		titleLbl.Parent = row

		local loadBtn = Instance.new("TextButton")
		loadBtn.Size = UDim2.new(0.22, -4, 0, 28)
		loadBtn.Position = UDim2.new(0.54, 0, 0.5, -14)
		loadBtn.Text = "تحميل"
		loadBtn.Parent = row
		styleActionButton(loadBtn, Theme.RobloxBlue, Theme.RobloxBlueHover)

		local delBtn = Instance.new("TextButton")
		delBtn.Size = UDim2.new(0.22, -4, 0, 28)
		delBtn.Position = UDim2.new(0.77, 0, 0.5, -14)
		delBtn.Text = "حذف"
		delBtn.Parent = row
		styleActionButton(delBtn, Theme.Danger, Theme.DangerHover)

		loadBtn.MouseButton1Click:Connect(function()
			CodeTextBox.Text = item.Code
			StatusLabel.Text = "تم تحميل: " .. item.Name
			StatusLabel.TextColor3 = Theme.RobloxBlueHover
			-- الانتقال تلقائياً لتبويب التشغيل
			ExecutePage.Visible = true
			SavedPage.Visible = false
			LearnPage.Visible = false
		end)

		delBtn.MouseButton1Click:Connect(function()
			table.remove(SavedScripts, index)
			refreshSavedList()
		end)
	end

	task.defer(function()
		SavedList.CanvasSize = UDim2.new(0, 0, 0, SavedListLayout.AbsoluteContentSize.Y + 12)
	end)
end

SaveCurrentBtn.MouseButton1Click:Connect(function()
	local codeToSave = CodeTextBox.Text
	if not codeToSave or codeToSave:match("^%s*$") then
		StatusLabel.Text = "لا يوجد كود لحفظه"
		StatusLabel.TextColor3 = Theme.DangerHover
		return
	end

	local chosenName = ScriptNameInput.Text
	if not chosenName or chosenName:match("^%s*$") then
		chosenName = "سكربت محفوظ #" .. tostring(#SavedScripts + 1)
	end

	table.insert(SavedScripts, 1, {
		Name = chosenName,
		Code = codeToSave
	})
	ScriptNameInput.Text = ""
	refreshSavedList()
	StatusLabel.Text = "تم حفظ: " .. chosenName
	StatusLabel.TextColor3 = Theme.GreenHover
end)

