local function toggleMenu()
	isOpen = not isOpen
	if isOpen then
		isCollapsed = false
		CollapseBtn.Text = "_"
		MainFrame.Position = UDim2.new(0, ToggleBtn.Position.X.Offset, 0, ToggleBtn.Position.Y.Offset + ToggleBtn.Size.Y.Offset + 4)
		applyFrameState(false)
	else
		applyFrameState(false)
	end
end

