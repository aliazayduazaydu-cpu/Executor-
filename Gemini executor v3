-- منطق التنفيذ المرتبط بالبيئة المحلية (game)
local function runUserCode(sourceCode)
	if not sourceCode or sourceCode:match("^%s*$") then
		StatusLabel.Text = "الحقل فارغ"
		StatusLabel.TextColor3 = Theme.TextMuted
		return
	end

	-- دعم صريح في حال كتب المستخدم رابط HttpGet مباشرة أو كود Luau كامل
	local finalCode = sourceCode
	local trimmed = sourceCode:match("^%s*(.-)%s*$")
	if trimmed:match("^https?://") then
		finalCode = string.format('loadstring(game:HttpGet(%q))()', trimmed)
	end

	-- محاولة استدعاء loadstring إن كانت مفعلة في البيئة
	local loader = loadstring
	if not loader then
		StatusLabel.Text = "loadstring غير مفعّل في اللعبة"
		StatusLabel.TextColor3 = Theme.DangerHover
		warn("[Executor] loadstring غير متاح على العميل في هذه التجربة. فعّل LoadStringEnabled في ServerScriptService للتنفيذ الديناميكي.")
		return
	end

	local fn, compileErr = loader(finalCode)
	if not fn then
		StatusLabel.Text = "خطأ في صياغة الكود"
		StatusLabel.TextColor3 = Theme.DangerHover
		warn("[Executor Syntax Error]:", compileErr)
		return
	end

	-- ربط الكود ببيئة اللعبة الحالية (game)
	local env = setmetatable({
		game = game,
		workspace = workspace,
		script = script,
		print = print,
		warn = warn
	}, { __index = getfenv and getfenv(0) or _G })

	if setfenv then
		pcall(setfenv, fn, env)
	end

	local ok, runErr = pcall(function()
		return fn()
	end)

	if ok then
		StatusLabel.Text = "تم التشغيل بنجاح ✓"
		StatusLabel.TextColor3 = Theme.GreenHover
	else
		StatusLabel.Text = "حدث خطأ أثناء التشغيل"
		StatusLabel.TextColor3 = Theme.DangerHover
		warn("[Executor Runtime Error]:", runErr)
	end
end

