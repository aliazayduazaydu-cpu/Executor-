local function tweenPos(obj, x, y, duration)
	local t = TweenService:Create(
		obj,
		TweenInfo.new(duration or 0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Position = UDim2.fromOffset(x, y) }
	)
	t:Play()
	return t
end

-- حساب أقرب زاوية لإخفاء العنصر جزئياً في زاوية الشاشة عند الإخفاء أو السحب للحافة
local function getCornerHidePosition(obj)
	local vp = getViewport()
	local sz = obj.AbsoluteSize
	local pos = obj.AbsolutePosition
	local centerX = pos.X + (sz.X * 0.5)
	local centerY = pos.Y + (sz.Y * 0.5)

	local isLeft = centerX < (vp.X * 0.5)
	local isTop = centerY < (vp.Y * 0.5)

	local peek = 14
	local targetX = isLeft and (-sz.X + peek) or (vp.X - peek)
	local targetY = isTop and (-sz.Y + peek) or (vp.Y - peek)
	return targetX, targetY
end

local function clampVisiblePosition(obj, x, y)
	local vp = getViewport()
	local sz = obj.AbsoluteSize
	local pad = 10
	local maxX = math.max(pad, vp.X - sz.X - pad)
	local maxY = math.max(pad, vp.Y - sz.Y - pad)
	return math.clamp(x, pad, maxX), math.clamp(y, pad, maxY)
end

