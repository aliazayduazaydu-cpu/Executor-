end

local function runLoadstring(codeText, sourceName)
	if type(codeText) ~= "string" or codeText:match("^%s*$") then
		warn("[Executor] Empty code.")
		return false
	end

	local loader = loadstring
	if type(loader) ~= "function" then
		warn("[Executor] loadstring unavailable.")
		return false
	end

	local fn, compErr = loader(codeText, "@" .. tostring(sourceName or "Script"))
	if not fn then
		warn("[Executor] Compile Error: " .. tostring(compErr))
		return false
	end

	local ok, runErr = pcall(fn)
	if not ok then
		warn("[Executor] Runtime Error: " .. tostring(runErr))
		return false
	end

	return true
end

