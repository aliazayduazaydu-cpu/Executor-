local ReadyState = {
	SpeedEnabled = false,
	SpeedValue = 36,
	JumpEnabled = false,
	JumpValue = 85,
	InfJumpEnabled = false,
	BoxEspEnabled = false,
}

local espBoxes = {}
local infJumpConn = nil
local espRenderConn = nil
local characterLoopConn = nil

local function getHumanoid()
	local char = LocalPlayer.Character
	if not char then return nil end
	return char:FindFirstChildOfClass("Humanoid")
end

local function applyMovementStats()
	local hum = getHumanoid()
	if not hum then return end

	if ReadyState.SpeedEnabled then
		hum.WalkSpeed = ReadyState.SpeedValue
	else
		hum.WalkSpeed = 16
	end

	if ReadyState.JumpEnabled then
		hum.UseJumpPower = true
		hum.JumpPower = ReadyState.JumpValue
	else
		hum.UseJumpPower = true
		hum.JumpPower = 50
	end
end

local function clearAllEspBoxes()
	for _, box in pairs(espBoxes) do
		if box and box.Parent then
			box:Destroy()
		end
	end
	table.clear(espBoxes)
end

local function ensureBoxForPlayer(plr)
	if plr == LocalPlayer then return nil end
	local char = plr.Character
	if not char then return nil end
	local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
	if not root then return nil end

	local existing = espBoxes[plr]
	if existing and existing.Parent and existing.Adornee == root then
		return existing
	end

	if existing then
		existing:Destroy()
	end

	local box = Instance.new("BoxHandleAdornment")
	box.Name = "SquareEspBox_" .. plr.Name
	box.Adornee = root
	box.AlwaysOnTop = true
	box.ZIndex = 10
	box.Size = Vector3.new(4, 5.5, 2.5)
	box.Color3 = Color3.fromRGB(205, 212, 222)
	box.Transparency = 0.55
	box.Parent = getUiParent()

	espBoxes[plr] = box
	return box
end

local function updateBoxEsp()
	if not ReadyState.BoxEspEnabled then
		clearAllEspBoxes()
		return
	end

	for plr, box in pairs(espBoxes) do
		if not plr.Parent or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
			if box then box:Destroy() end
			espBoxes[plr] = nil
		end
	end

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and plr.Character then
			local hum = plr.Character:FindFirstChildOfClass("Humanoid")
			local box = ensureBoxForPlayer(plr)
			if box then
				box.Visible = (hum ~= nil and hum.Health > 0)
			end
		end
	end
end

local function setInfJump(enabled)
	ReadyState.InfJumpEnabled = enabled
	if infJumpConn then
		infJumpConn:Disconnect()
		infJumpConn = nil
	end
	if enabled then
		infJumpConn = UserInputService.JumpRequest:Connect(function()
			if not ReadyState.InfJumpEnabled then return end
			local hum = getHumanoid()
			if hum then
				hum:ChangeState(Enum.HumanoidStateType.Jumping)
			end
		end)
	end
end

local function setBoxEsp(enabled)
	ReadyState.BoxEspEnabled = enabled
	if espRenderConn then
		espRenderConn:Disconnect()
		espRenderConn = nil
	end
	if enabled then
		updateBoxEsp()
		espRenderConn = RunService.RenderStepped:Connect(updateBoxEsp)
	else
		clearAllEspBoxes()
	end
end

local function stopAllFeatures()
	ReadyState.SpeedEnabled = false
	ReadyState.JumpEnabled = false
	setInfJump(false)
	setBoxEsp(false)
	applyMovementStats()
end

if not characterLoopConn then
	characterLoopConn = LocalPlayer.CharacterAdded:Connect(function()
		task.wait(0.25)
		applyMovementStats()
		if ReadyState.BoxEspEnabled then
			clearAllEspBoxes()
			updateBoxEsp()
		end
	end)
end

