-- سحب سلس للنافذة أو الزر مع إمكانية الإخفاء في الزاوية إذا تم سحب العنصر حتى الحافة
local function attachDraggable(handle, target, onTap, onReleaseCallback)
	local dragging = false
	local moved = 0
	local startInput = Vector2.zero
	local startPos = Vector2.zero

	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			moved = 0
			startInput = input.Position
			startPos = Vector2.new(target.AbsolutePosition.X, target.AbsolutePosition.Y)

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					if moved < 8 and type(onTap) == "function" then
						onTap()
					elseif type(onReleaseCallback) == "function" then
						onReleaseCallback(target)
					end
				end
			end)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - startInput
			moved = math.max(moved, delta.Magnitude)
			local nextX = startPos.X + delta.X
			local nextY = startPos.Y + delta.Y
			target.Position = UDim2.fromOffset(nextX, nextY)
		end
	end)
end

local function checkEdgeCornerSnap(obj, setHiddenFn, setLastPosFn)
	local vp = getViewport()
	local pos = obj.AbsolutePosition
	local sz = obj.AbsoluteSize
	local nearEdge = (pos.X <= 4) or (pos.Y <= 4) or ((pos.X + sz.X) >= (vp.X - 4)) or ((pos.Y + sz.Y) >= (vp.Y - 4))
	if nearEdge then
		setHiddenFn(true)
	else
		local vx, vy = clampVisiblePosition(obj, pos.X, pos.Y)
		setLastPosFn(Vector2.new(vx, vy))
		tweenPos(obj, vx, vy, 0.18)
	end
end

