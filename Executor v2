local function fitViewport()
	local vp = getViewport()
	local w = math.clamp(vp.X - 48, 300, 560)
	local h = math.clamp(vp.Y - 32, 230, 330)
	MainFrame.Size = UDim2.fromOffset(w, h)

	if isWindowHiddenToCorner then
		local cx, cy = getCornerHidePosition(MainFrame)
		MainFrame.Position = UDim2.fromOffset(cx, cy)
	else
		local vx, vy = clampVisiblePosition(MainFrame, MainFrame.AbsolutePosition.X, MainFrame.AbsolutePosition.Y)
		MainFrame.Position = UDim2.fromOffset(vx, vy)
	end

	if isToggleHiddenToCorner then
		local tx, ty = getCornerHidePosition(ToggleBtn)
		ToggleBtn.Position = UDim2.fromOffset(tx, ty)
	else
		local tx, ty = clampVisiblePosition(ToggleBtn, ToggleBtn.AbsolutePosition.X, ToggleBtn.AbsolutePosition.Y)
		ToggleBtn.Position = UDim2.fromOffset(tx, ty)
	end
end

