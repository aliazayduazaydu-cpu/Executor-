local function fetchSinglePage(queryText, pageNum)
	local term = tostring(queryText or ""):gsub("^%s+", ""):gsub("%s+$", "")
	if term == "" then
		term = "hub"
	end

	local url = "https://scriptblox.com/api/script/search?q=" .. HttpService:UrlEncode(term) .. "&page=" .. tostring(pageNum)
	local ok, raw = pcall(function()
		return game:HttpGetAsync(url)
	end)
	if not ok or not raw then
		return 0
	end

	local decOk, data = pcall(function()
		return HttpService:JSONDecode(raw)
	end)
	if not decOk or not data or not data.result or type(data.result.scripts) ~= "table" then
		return 0
	end

	local added = 0
	for _, sc in ipairs(data.result.scripts) do
		local isFree = (sc.scriptType == nil or sc.scriptType == "free")
		local notPatched = (sc.isPatched ~= true)
		if isFree and notPatched and sc.script then
			local uniqueKey = tostring(sc._id or sc.title or "") .. "|" .. tostring(#sc.script)
			if not seenKeys[uniqueKey] then
				seenKeys[uniqueKey] = true
				local thumb = ICONS.Thumb
				if not sc.isUniversal and sc.game and sc.game.gameId then
					thumb = "https://assetgame.roblox.com/Game/Tools/ThumbnailAsset.ashx?aid=" .. tostring(sc.game.gameId) .. "&fmt=png&wd=420&ht=420"
				end
				addResultRow(sc.title, sc.game and sc.game.name or "Universal", sc.script, thumb)
				added += 1
			end
		end
	end
	return added
end

local function runSearchBatch(queryText, pagesCount)
	resetResults()
	activeQuery = queryText
	for p = 1, (pagesCount or 2) do
		loadedPage = p
		local added = fetchSinglePage(activeQuery, p)
		if added == 0 then
			break
		end
	end
	filterCards()
end

